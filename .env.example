# =============================================================================
# MiDoctorYa Lite PWA - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Server ---
PORT=8081
FLASK_DEBUG=false
ALLOWED_ORIGIN=*

# --- Mercado Pago ---
# Get your access token from: https://www.mercadopago.com.co/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
# Set to "true" for sandbox/testing, "false" for production
MP_SANDBOX=true

# --- SendGrid (Email) ---
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# The "from" email address (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=noreply@midoctorya.com

# --- UltraMSG (WhatsApp) ---
# Get your credentials from: https://ultramsg.com/
ULTRAMSG_INSTANCE=instanceXXXX
ULTRAMSG_TOKEN=xxxxxxxxxxxx

# --- Google Fit (Wearable Data) ---
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_FIT_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_FIT_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# --- Admin Panel ---
# PIN code for accessing the admin panel
ADMIN_PIN=1234
